{
  "name": "cross-log",
  "version": "0.4.0",
  "description": "A universal logging package that works in both browser and Node.js environments with environment variable configuration",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/index.esm.js",
        "require": "./dist/index.js"
      },
      "browser": "./dist/index.esm.js",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/adapters/edge.d.ts",
      "edge-runtime": "./dist/adapters/edge.esm.js",
      "cloudflare-worker": "./dist/adapters/edge.esm.js",
      "vercel-edge": "./dist/adapters/edge.esm.js",
      "import": "./dist/adapters/edge.esm.js",
      "require": "./dist/adapters/edge.js",
      "default": "./dist/adapters/edge.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "import": "./dist/adapters/next.esm.js",
      "require": "./dist/adapters/next.js",
      "default": "./dist/adapters/next.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "node": {
        "import": "./dist/adapters/node.esm.js",
        "require": "./dist/adapters/node.js"
      },
      "import": "./dist/adapters/node.esm.js",
      "require": "./dist/adapters/node.js",
      "default": "./dist/adapters/node.js"
    },
    "./browser": {
      "types": "./dist/adapters/browser.d.ts",
      "browser": "./dist/adapters/browser.esm.js",
      "import": "./dist/adapters/browser.esm.js",
      "require": "./dist/adapters/browser.js",
      "default": "./dist/adapters/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "edge",
    "next",
    "node",
    "browser"
  ],
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "logger",
    "logging",
    "universal",
    "browser",
    "nodejs",
    "typescript",
    "environment",
    "debug",
    "edge-runtime",
    "cloudflare-workers",
    "vercel-edge",
    "nextjs",
    "cross-platform"
  ],
  "author": "dev-ignis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-ignis/cross-log.git"
  },
  "homepage": "https://github.com/dev-ignis/cross-log#readme",
  "bugs": {
    "url": "https://github.com/dev-ignis/cross-log/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "prettier": "^3.0.0",
    "rollup": "^3.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.0.0",
    "typescript": "~5.5.0"
  }
}
